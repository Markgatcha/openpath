{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenPath",
  "version": "0.4.0",
  "identifier": "dev.openpath.app",
  "build": {
    "frontendDist": "../dist/web",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": null
  },
  "app": {
    "windows": [
      {
        "title": "OpenPath",
        "width": 1280,
        "height": 800,
        "minWidth": 880,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "nsis"],
    "externalBin": ["binaries/server"],
    "resources": { "native/app": "app" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "copyright": "MIT",
    "shortDescription": "Local-first gamified learning platform",
    "longDescription": "OpenPath turns quizzes, flashcards, and daily practice into an adventure — all on your own machine. One window, one SQLite file, no cloud account."
  }
}
