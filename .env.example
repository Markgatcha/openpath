# ── OpenPath server ────────────────────────────────────────────
# Port for the API + production web server
PORT=8787

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-secret-change-me-in-production

# SQLite database file location (created automatically)
DATABASE_PATH=./data/openpath.db

# Seed demo classrooms, quizzes, and accounts on first boot
SEED_DEMO_DATA=true

# ── AI question generation (optional) ──────────────────────────
# The app works fully without AI. Configure a provider here or in
# Settings → AI inside the app (UI settings win and are never committed).
#
# provider: "openrouter" (hosted, needs an API key) or "local"
#           (Ollama / llama.cpp / any OpenAI-compatible endpoint)
AI_PROVIDER=local

# OpenRouter — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# Local model — Ollama default shown; llama.cpp server uses
# http://localhost:8080/v1
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=qwen3:8b
